# Copy this file to .env and fill in real values. Never commit the real .env.

# --- App ---
ENV=development
DEBUG=true

# --- Database (Postgres via docker-compose, or your own local instance) ---
DATABASE_URL=postgresql+psycopg2://ecotrack:ecotrack@localhost:5432/ecotrack

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- File storage ---
# STORAGE_PROVIDER=local works with zero extra setup.
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=8

# Only needed if STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- ML ---
# demo = lightweight heuristic classifier, works with zero setup.
# production = loads your trained model from ml/models/waste_classifier.h5
ML_MODE=demo
ML_MODEL_PATH=../ml/models/waste_classifier.h5
ML_DUPLICATE_SIMILARITY_THRESHOLD=0.82
